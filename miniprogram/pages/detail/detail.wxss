.detail-page { min-height:100vh; padding:0 40rpx calc(64rpx + env(safe-area-inset-bottom)); overflow:hidden; }
.detail-nav { position:relative; box-sizing:border-box; }
.detail-nav-row { position:relative; display:flex; align-items:center; justify-content:center; }
.nav-back { position:absolute; left:0; top:50%; width:88rpx; height:88rpx; color:#463b39; font-size:76rpx; font-weight:300; line-height:76rpx; text-align:left; transform:translateY(-50%); }
.nav-title { color:#463b39; font-size:36rpx; font-weight:400; line-height:52rpx; }
.pager-count { display:block; margin-top:56rpx; color:#8d817c; font-size:26rpx; line-height:40rpx; text-align:right; }
.detail-pager { position:relative; margin-top:24rpx; }
.book-stack { position:absolute; z-index:3; top:112rpx; left:-36rpx; display:flex; flex-direction:column; gap:164rpx; pointer-events:none; }
.book-ring { width:42rpx; height:28rpx; border:7rpx solid #b9aaa0; border-right:0; border-radius:20rpx 0 0 20rpx; background:#fff9f5; box-shadow:-3rpx 4rpx 8rpx rgba(70,59,57,.12); }
.detail-note { position:relative; overflow:hidden; box-sizing:border-box; background:#fffcfa; border:2rpx solid #f1e8e3; border-radius:40rpx; box-shadow:0 12rpx 40rpx rgba(91,61,47,.08); }
.note-margin { position:absolute; z-index:4; top:0; bottom:0; left:48rpx; width:16rpx; background:#f7d9d3; pointer-events:none; }
.page-leaf { position:relative; z-index:1; box-sizing:border-box; min-height:100%; padding:64rpx 40rpx 48rpx 96rpx; background:#fffcfa; }
.page-current { min-height:632rpx; }
.page-turning { position:absolute; z-index:3; top:0; right:0; bottom:0; left:64rpx; padding-left:32rpx; overflow:hidden; transform-origin:left center; transform-style:preserve-3d; backface-visibility:hidden; will-change:transform, opacity; }
.page-turning::after { position:absolute; top:0; right:0; bottom:0; left:0; content:''; pointer-events:none; background:linear-gradient(90deg, rgba(75,55,45,.04), rgba(75,55,45,.23)); opacity:0; }
.note-title { position:relative; z-index:1; box-sizing:border-box; min-height:68rpx; padding:22rpx 4rpx 0 0; border-bottom:2rpx solid #eee4de; color:#463b39; font-size:38rpx; font-weight:600; line-height:44rpx; word-break:break-all; }
.note-edit { position:absolute; z-index:5; top:40rpx; right:40rpx; display:flex; align-items:center; gap:8rpx; padding:8rpx 0 8rpx 16rpx; color:#8d817c; font-size:28rpx; line-height:40rpx; }
.note-edit-icon { color:#8d817c; font-size:36rpx; line-height:40rpx; transform:rotate(-12deg); }
.note-guides { position:relative; z-index:1; height:204rpx; }
.note-line { height:68rpx; box-sizing:border-box; border-bottom:2rpx solid #eee4de; }
.note-details { position:relative; z-index:1; margin-top:32rpx; }
.detail-row { display:flex; min-height:56rpx; align-items:baseline; }
.detail-label { flex:0 0 144rpx; color:#8d817c; font-size:26rpx; line-height:40rpx; }
.detail-value { flex:1; color:#463b39; font-size:28rpx; line-height:40rpx; }
.location-row { margin-top:8rpx; color:#463b39; font-size:28rpx; line-height:40rpx; }
.reminder-state { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-end; margin-top:24rpx; color:#8d817c; pointer-events:none; }
.state-label { font-size:26rpx; line-height:40rpx; font-weight:500; }
.state-time { margin-top:8rpx; color:#8d817c; font-size:24rpx; line-height:36rpx; text-align:right; }
.state-success .state-label { color:#639879; }
.state-warning .state-label { color:#a46d64; }
.page-turning.turn-next { animation:page-turn-next 420ms cubic-bezier(.22,.72,.2,1) both; }
.page-turning.turn-prev { animation:page-turn-prev 420ms cubic-bezier(.22,.72,.2,1) both; transform-origin:right center; }
.page-turning.turn-next::after { animation:page-shadow-next 420ms ease-out both; }
.page-turning.turn-prev::after { background:linear-gradient(270deg, rgba(75,55,45,.04), rgba(75,55,45,.23)); animation:page-shadow-prev 420ms ease-out both; }
@keyframes page-turn-next { 0% { opacity:1; transform:perspective(1600rpx) rotateY(0); } 58% { opacity:1; transform:perspective(1600rpx) rotateY(-88deg); } 100% { opacity:0; transform:perspective(1600rpx) rotateY(-155deg); } }
@keyframes page-turn-prev { 0% { opacity:1; transform:perspective(1600rpx) rotateY(0); } 58% { opacity:1; transform:perspective(1600rpx) rotateY(88deg); } 100% { opacity:0; transform:perspective(1600rpx) rotateY(155deg); } }
@keyframes page-shadow-next { 0%, 100% { opacity:0; } 50% { opacity:1; } }
@keyframes page-shadow-prev { 0%, 100% { opacity:0; } 50% { opacity:1; } }
.detail-message { margin-top: 32rpx; color: #8d817c; font-size: 26rpx; line-height: 40rpx; }
.detail-retry { margin: 8rpx 0 0; padding: 0; min-height: 88rpx; color: #de746b; background: transparent; font-size: 26rpx; line-height: 88rpx; text-align: left; }
