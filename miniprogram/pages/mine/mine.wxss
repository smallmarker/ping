.mine-page { padding-top:48rpx; }.profile { display:flex; align-items:center; gap:22rpx; }.avatar { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; border-radius:50%; background:#fff0eb; color:#d07168; font-size:38rpx; font-weight:600; }.name { font-size:34rpx; font-weight:600; }.hint { margin-top:8rpx; color:#938984; font-size:24rpx; }.stats { display:flex; margin-top:48rpx; padding:28rpx 0; background:#fff; border:1rpx solid #f1e8e3; border-radius:24rpx; }.stats view { flex:1; display:flex; flex-direction:column; align-items:center; color:#8c827d; font-size:24rpx; }.stats view + view { border-left:1rpx solid #f1e8e3; }.stat-number { margin-bottom:10rpx; color:#403937; font-size:38rpx; font-weight:600; }.stats-error { margin-top:14rpx; text-align:center; color:#a46d64; font-size:23rpx; }.co-create { position:relative; margin-top:28rpx; padding:30rpx; background:#f4f0fa; border-radius:24rpx; }.co-title { color:#554d5e; font-size:30rpx; font-weight:600; }.co-copy { margin-top:10rpx; color:#867c90; font-size:24rpx; }.co-create > text { position:absolute; right:30rpx; top:44rpx; color:#968aa1; font-size:38rpx; }.menu { margin-top:38rpx; background:#fff; border:1rpx solid #f1e8e3; border-radius:24rpx; }.menu view { padding:28rpx; color:#5d5450; font-size:28rpx; border-bottom:1rpx solid #f4ece8; }.menu view:last-child { border-bottom:0; }.menu text { float:right; color:#b2a7a1; font-size:34rpx; }.version { margin-top:44rpx; text-align:center; color:#aaa09a; font-size:23rpx; }
.avatar { background:#fff9f5 url('../../assets/ping-logo-v1.png') center/cover no-repeat; color:transparent; font-size:0; }
.avatar { overflow:hidden; background:#fff9f5; }.avatar image { display:block; width:100%; height:100%; }
.avatar { position:relative; background:#fff0eb; color:inherit; font-size:inherit; }.avatar-note { position:relative; width:40rpx; height:48rpx; background:#fff; border:3rpx solid #322e2d; border-radius:10rpx; box-sizing:border-box; }.avatar-dot { position:absolute; top:-10rpx; right:-10rpx; width:18rpx; height:18rpx; background:#f28c82; border:3rpx solid #fff0eb; border-radius:50%; }.avatar-line { position:absolute; left:10rpx; height:3rpx; background:#d9cff0; border-radius:3rpx; }.line-one { top:17rpx; width:18rpx; }.line-two { top:28rpx; width:13rpx; }
.mine-page .co-create { display:block; box-sizing:border-box; width:100%; margin-left:0; margin-right:0; padding:30rpx; border:0; font-family:inherit; font-size:30rpx; font-weight:400; line-height:normal; text-align:left; white-space:normal; }
.co-create::after { border:0; }
.co-create-pressed { background:#ece6f4; }
