.completed-page { padding-top:40rpx; }.page-title { color:#322e2d; font-size:44rpx; line-height:60rpx; font-weight:600; }.page-subtitle { margin-top:10rpx; color:#827a76; font-size:26rpx; }.completed-list { margin-top:44rpx; }.completed-card { position:relative; margin-top:16rpx; padding:24rpx 64rpx 24rpx 26rpx; background:#fff; border:1rpx solid #f1e8e3; border-radius:22rpx; }.card-top { display:flex; align-items:center; justify-content:space-between; }.done-chip { padding:4rpx 12rpx; border:1rpx solid #a9cdb8; border-radius:8rpx; color:#639879; font-size:20rpx; }.completed-time { color:#a49a95; font-size:22rpx; }.card-title { margin-top:18rpx; color:#5d5653; font-size:30rpx; line-height:42rpx; font-weight:500; word-break:break-all; }.card-meta { margin-top:8rpx; color:#938a86; font-size:23rpx; }.arrow { position:absolute; top:50%; right:26rpx; color:#b4aca8; font-size:38rpx; transform:translateY(-50%); }.state-copy { margin-top:80rpx; text-align:center; color:#938a86; font-size:26rpx; }.error-copy { color:#a46d64; }.error-copy text { color:#82564f; text-decoration:underline; }.empty-note { margin-top:80rpx; padding:40rpx 20rpx; text-align:center; color:#655c58; font-size:28rpx; }.empty-note text { display:block; margin-top:12rpx; color:#a69d98; font-size:24rpx; }.empty-mark { color:#77af91; font-size:58rpx; line-height:48rpx; }
